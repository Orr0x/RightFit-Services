# =====================================================
# RightFit Services - Separated Services Environment Configuration
# =====================================================
# This file configures the separated services architecture with
# independent databases for cleaning and maintenance services
#
# **SECURITY NOTICE**: This file contains only placeholder values.
# Actual secrets should be stored in your local .env file or
# secure secret management system.

# -----------------------------------------------------
# Service Mode Configuration
# -----------------------------------------------------
# Controls whether to use unified or separated database architecture
# Options: unified, separated, migration, rollback
SERVICE_MODE=separated

# Database Migration Configuration
# Options: dry_run, validate, execute, rollback
MIGRATION_MODE=dry_run

# Enable verbose migration logging
MIGRATION_VERBOSE=true

# Enable debug mode for detailed logging
MIGRATION_DEBUG=true

# Enable database query logging
DB_LOG_QUERIES=true

# Set slow query threshold in milliseconds
DB_SLOW_QUERY_THRESHOLD=1000

# -----------------------------------------------------
# Authentication Service Configuration
# -----------------------------------------------------
# Shared Authentication Database (Port 5434)
SHARED_AUTH_DATABASE_URL=postgresql://rightfit_auth_user:secure_auth_password@localhost:5434/rightfit_auth

# Auth Service Configuration
SHARED_AUTH_API_URL=http://localhost:3002
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Auth Service Health Check
SHARED_AUTH_HEALTH_CHECK_INTERVAL=30000
SHARED_AUTH_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------
# Cleaning Service Configuration
# -----------------------------------------------------
# Cleaning Database (Port 5435)
CLEANING_DATABASE_URL=postgresql://cleaning_user:secure_cleaning_password@localhost:5435/rightfit_cleaning

# Cleaning Service API Configuration
CLEANING_API_URL=http://localhost:3001
CLEANING_WEB_URL=http://localhost:5174
CLEANING_SERVICE_TYPE=cleaning

# Cleaning Database Connection Pool
CLEANING_DB_POOL_MIN=2
CLEANING_DB_POOL_MAX=10

# Cleaning Service Features
CLEANING_ENABLE_PHOTO_UPLOAD=true
CLEANING_ENABLE_JOB_SCHEDULING=true
CLEANING_ENABLE_CERTIFICATE_MANAGEMENT=true
CLEANING_ENABLE_INTEGRATION_TESTING=true

# -----------------------------------------------------
# Maintenance Service Configuration
# -----------------------------------------------------
# Maintenance Database (Port 5436)
MAINTENANCE_DATABASE_URL=postgresql://maintenance_user:secure_maintenance_password@localhost:5436/rightfit_maintenance

# Maintenance Service API Configuration
MAINTENANCE_API_URL=http://localhost:3003
MAINTENANCE_WEB_URL=http://localhost:5175
MAINTENANCE_SERVICE_TYPE=maintenance

# Maintenance Database Connection Pool
MAINTENANCE_DB_POOL_MIN=2
MAINTENANCE_DB_POOL_MAX=10

# Maintenance Service Features
MAINTENANCE_ENABLE_WORK_ORDERS=true
MAINTENANCE_ENABLE_CONTRACTOR_MANAGEMENT=true
MAINTENANCE_ENABLE_FINANCIAL_TRACKING=true
MAINTENANCE_ENABLE_PROPERTY_MANAGEMENT=true

# -----------------------------------------------------
# Original Unified Database (Port 5433) - Backward Compatibility
# -----------------------------------------------------
# Keep for backward compatibility and rollback
ORIGINAL_DATABASE_URL=postgresql://rightfit_user:rightfit_password@localhost:5433/rightfit_dev
DISABLE_UNIFIED_DATABASE=false

# -----------------------------------------------------
# Service Discovery & Registration
# -----------------------------------------------------
# Service Registry Configuration
SERVICE_REGISTRY_URL=http://localhost:3004
SERVICE_REGISTRY_ENABLED=true
SERVICE_HEALTH_CHECK_INTERVAL=30000

# Service Health Endpoints
CLEANING_HEALTH_ENDPOINT=http://localhost:3001/health
MAINTENANCE_HEALTH_ENDPOINT=http://localhost:3003/health
AUTH_HEALTH_ENDPOINT=http://localhost:3002/health

# -----------------------------------------------------
# Inter-Service Communication
# -----------------------------------------------------
# API Gateway Configuration
API_GATEWAY_URL=http://localhost:3000
API_GATEWAY_ENABLED=true
API_GATEWAY_RATE_LIMIT=1000
API_GATEWAY_TIMEOUT=30000

# Cross-Service Authentication
INTER_SERVICE_JWT_SECRET=your_inter_service_jwt_secret_key
INTER_SERVICE_TIMEOUT=10000

# -----------------------------------------------------
# External Service URLs
# -----------------------------------------------------
# Frontend Application URLs
CUSTOMER_WEB_URL=http://localhost:5176
LANDLORD_WEB_URL=http://localhost:5177
WORKER_APP_URL=http://localhost:5178

# Service Integration Endpoints
PAYMENT_SERVICE_URL=https://api.stripe.com/v1
NOTIFICATION_SERVICE_URL=http://localhost:3005
FILE_STORAGE_URL=http://localhost:3006

# -----------------------------------------------------
# Database Replication & Backup Configuration
# -----------------------------------------------------
# Replication Configuration (for production)
CLEANING_DB_REPLICA_URL=postgresql://cleaning_readonly:readonly_password@localhost:5437/rightfit_cleaning
MAINTENANCE_DB_REPLICA_URL=postgresql://maintenance_readonly:readonly_password@localhost:5438/rightfit_maintenance

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=rightfit-services-backups
BACKUP_ENCRYPTION_ENABLED=true

# -----------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------
# Application Metrics
ENABLE_METRICS_ENDPOINT=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENABLED=true

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
APM_SERVICE_NAME=rightfit-separated
APM_ENVIRONMENT=development

# -----------------------------------------------------
# Security Configuration
# -----------------------------------------------------
# CORS Configuration for Separated Services
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3003,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CSP=true

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/rightfit.crt
SSL_KEY_PATH=/etc/ssl/private/rightfit.key
SSL_ENABLED=false

# -----------------------------------------------------
# Development & Testing Configuration
# -----------------------------------------------------
# Test Database Configuration
TEST_CLEANING_DATABASE_URL=postgresql://test_cleaning:test_password@localhost:5439/test_cleaning
TEST_MAINTENANCE_DATABASE_URL=postgresql://test_maintenance:test_password@localhost:5400/test_maintenance

# Integration Testing Configuration
INTEGRATION_TESTING_ENABLED=true
INTEGRATION_TEST_TIMEOUT=30000
MOCK_EXTERNAL_SERVICES=true

# Development Tools
ENABLE_SWAGGER_DOCS=true
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_DEBUG_ENDPOINTS=true

# -----------------------------------------------------
# Email Services Configuration
# -----------------------------------------------------
# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=jamesrobins9@gmail.com

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------
# GPS and Navigation APIs
# -----------------------------------------------------
WEATHER_API_KEY=your_weather_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
WHAT3WORDS_API_KEY=your_what3words_api_key_here

# Mapbox Configuration
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
VITE_MAPBOX_SECRET_KEY=your_mapbox_secret_key_here

# -----------------------------------------------------
# Rate Limiting
# -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------
# Notes & Usage Instructions
# -----------------------------------------------------
#
# **Development Setup:**
# 1. Copy this file to .env and replace placeholder values
# 2. Run 'docker-compose -f docker-compose.separated.yml up -d'
# 3. Run 'npm run dev' to start services
#
# **Database Migration:**
# 1. Set MIGRATION_MODE=dry_run for testing
# 2. Set MIGRATION_MODE=execute for actual migration
# 3. Set MIGRATION_MODE=rollback if needed
#
# **Service Health Checks:**
# - Cleaning API: http://localhost:3001/health
# - Maintenance API: http://localhost:3003/health
# - Auth Service: http://localhost:3002/health
#
# **Database Ports:**
# - Shared Auth: 5434
# - Cleaning: 5435
# - Maintenance: 5436
# - Original (Backup): 5433
#
# **Security Notes:**
# - Never commit real secrets to version control
# - Use environment-specific .env files
# - Rotate secrets regularly
# - Use different secrets for each environment